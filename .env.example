# AI Travel Agent - Environment Configuration
# Copy this file to .env and fill in your actual credentials

# ===== FLASK CONFIGURATION =====
FLASK_ENV=production
FLASK_APP=main.py
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=False

# ===== DATABASE CONFIGURATION =====
DATABASE_URL=postgresql://user:password@localhost:5432/travel_agent_db
DB_ECHO=False
SQLALCHEMY_TRACK_MODIFICATIONS=False

# ===== AMADEUS FLIGHT API =====
AMADEUS_API_KEY=your-amadeus-api-key
AMADEUS_API_SECRET=your-amadeus-api-secret
AMADEUS_API_BASE_URL=https://test.api.amadeus.com
AMADEUS_TIMEOUT=10

# ===== GOOGLE APIs =====
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
GOOGLE_PLACES_API_KEY=your-google-places-api-key
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5000/auth/gmail/callback

# ===== GMAIL CONFIGURATION =====
GMAIL_SENDER_EMAIL=your-gmail-address@gmail.com
GMAIL_TOKEN_PICKLE_FILE=token.pickle
GMAIL_CREDENTIALS_FILE=credentials.json

# ===== OPENAI CONFIGURATION =====
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_INTENT_DETECTION_ENABLED=True

# ===== TRANSPORT APIs =====
SKYSCANNER_API_KEY=your-skyscanner-api-key
BOOKING_COM_API_KEY=your-booking-com-api-key
TRAINLINE_API_KEY=your-trainline-api-key
ROME2RIO_API_KEY=your-rome2rio-api-key

# ===== VISA & DOCUMENT VERIFICATION =====
SHERPA_VISA_API_KEY=your-sherpa-visa-api-key
DOCUMENT_VERIFICATION_API_KEY=your-document-api-key

# ===== PAYMENT GATEWAY =====
STRIPE_API_KEY=your-stripe-api-key
STRIPE_PUBLIC_KEY=your-stripe-public-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# ===== PAYMENT: PayPal =====
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_MODE=sandbox

# ===== PAYMENT: Razorpay (India) =====
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# ===== CURRENCY & EXCHANGE RATE =====
EXCHANGE_RATE_API_KEY=your-exchange-rate-api-key
FIXER_API_KEY=your-fixer-api-key

# ===== LOGGING & MONITORING =====
LOG_LEVEL=INFO
LOG_FILE=logs/travel_agent.log
SENTRY_DSN=your-sentry-dsn-for-error-tracking

# ===== SECURITY =====
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,https://yourdomain.com
JWT_SECRET_KEY=your-jwt-secret-key
JWT_EXPIRATION_HOURS=24

# ===== EMAIL NOTIFICATIONS =====
EMAIL_SERVICE=smtp
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
ADMIN_EMAIL=admin@travel-agent.com

# ===== WEATHER API =====
WEATHER_API_KEY=your-weather-api-key
WEATHER_SERVICE=openweathermap

# ===== LOCAL SEARCH & RECOMMENDATIONS =====
FOURSQUARE_CLIENT_ID=your-foursquare-client-id
FOURSQUARE_CLIENT_SECRET=your-foursquare-client-secret
YELP_API_KEY=your-yelp-api-key

# ===== TRANSLATION SERVICE =====
GOOGLE_TRANSLATE_API_KEY=your-translate-api-key
ENABLE_MULTILINGUAL=True
DEFAULT_LANGUAGE=en

# ===== FRONTEND CONFIGURATION =====
REACT_APP_API_BASE_URL=http://localhost:5000
REACT_APP_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
REACT_APP_GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id

# ===== CACHING =====
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=True
CACHE_TTL_SECONDS=3600

# ===== FILE UPLOAD =====
MAX_UPLOAD_SIZE_MB=10
UPLOAD_FOLDER=uploads/
ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png,docx

# ===== RATE LIMITING =====
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS_PER_HOUR=1000

# ===== PRODUCTION DEPLOYMENT =====
ENVIRONMENT=production
API_TIMEOUT_SECONDS=30
MAX_WORKERS=4
